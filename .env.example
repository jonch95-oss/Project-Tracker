# Copy to .env.local for development. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pc_dev
# 32+ random chars: openssl rand -base64 48
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000
# Vercel Cron sends this as a Bearer token (also used by the backup workflow). openssl rand -hex 24
CRON_SECRET=
# One-time key for /setup (creates the first owner on an empty database). openssl rand -hex 24
SETUP_KEY=

# Email is on hold (no sender yet). Leave empty: dev prints mail to the console; production records "skipped".
RESEND_API_KEY=
# Email into a project (Module I): off unless both are set.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
EMAIL_FROM="Project Command <projects@liandev.com>"
OWNER_ALERT_EMAIL=

# Optional usage APIs for the System page
NEON_API_KEY=
NEON_PROJECT_ID=
# Read-only Vercel token for the $20 Pro credit meter
VERCEL_USAGE_TOKEN=
VERCEL_TEAM_ID=

# Vercel Blob (private store). Added automatically when the store is connected to the project.
# Without it, local dev uses in-memory storage.
BLOB_READ_WRITE_TOKEN=

# NYC Open Data (Socrata) app token for the public-records watch
SOCRATA_APP_TOKEN=
