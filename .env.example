# Copy to .env.local for development. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pc_dev
# 32+ random chars: openssl rand -base64 48
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000
# Shared secret the GitHub Actions scheduled jobs send as a Bearer token
JOB_SECRET=

# Email (Resend free plan). Leave empty in dev: mail is stored in the outbox and printed to the console.
RESEND_API_KEY=
EMAIL_FROM="Project Command <projects@liandev.com>"
OWNER_ALERT_EMAIL=

# Optional usage APIs for the System page
NEON_API_KEY=
NEON_PROJECT_ID=
GITHUB_USAGE_TOKEN=
